{
  "type": "SMS",
  "event": "balance_alert",
  "locale": ["en_US"],
  "metadata": {
    "default": {
      "templateContentId": "FFASK009",
      "attributes": {
        "CUST_FULL_NM": "$params.fullName",
        "ACCT_NO": "$params.accountNumber",
        "CURR_BAL": "$params.currentBalance",
        "ALERT_THRESHOLD": "$params.alertThreshold",
        "ALERT_DT": "$params.alertDate",
        "DOC_DESC_NM": "Low Balance Alert"
      }
    }
  },
  "filterFields": {
    "alertType": ["low_balance"]
  }
}
